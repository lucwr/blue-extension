# --- Server ---
PORT=8787
NODE_ENV=development

# Comma-separated list of allowed origins for CORS. The Chrome extension is
# served from chrome-extension://<id>/, and the loader URL changes on every
# unpacked install — keep this permissive in dev and tighten in production.
CORS_ORIGINS=*

# --- Auth ---
# Required. HS256 secret used to sign short-lived JWTs that the extension
# presents on every API call.
JWT_SECRET=replace-me-with-a-long-random-string

# --- LLM (OpenRouter — OpenAI-compatible gateway) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model strings on OpenRouter are "<provider>/<model>".
# Browse models at https://openrouter.ai/models — pick by cost/quality.
# These defaults route to Claude through OpenRouter; you can swap to any model
# OpenRouter supports (e.g. openai/gpt-4o, google/gemini-pro-1.5, deepseek/deepseek-chat).
LLM_MODEL=anthropic/claude-3.5-sonnet
# Cheaper/faster for the JD analysis step:
LLM_MODEL_ANALYZE=anthropic/claude-3.5-haiku
# Resume gen is the highest-value generation — spend on quality:
LLM_MODEL_RESUME=anthropic/claude-3.5-sonnet
LLM_MODEL_PROPOSAL=anthropic/claude-3.5-sonnet

# Per-call timeout (ms).
LLM_TIMEOUT_MS=60000
# Retries when the model returns malformed JSON or fails Zod validation.
# (The SDK auto-retries 429/5xx separately with backoff.)
LLM_MAX_VALIDATION_RETRIES=2

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
