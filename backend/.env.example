# --- Server ---
PORT=8787
NODE_ENV=development

# Comma-separated list of allowed origins for CORS. The Chrome extension is
# served from chrome-extension://<id>/, and the loader URL changes on every
# unpacked install — keep this permissive in dev and tighten in production.
CORS_ORIGINS=*

# --- Auth ---
# Required. HS256 secret used to sign short-lived JWTs that the extension
# presents on every API call.
JWT_SECRET=replace-me-with-a-long-random-string

# --- LLM (OpenRouter — OpenAI-compatible gateway) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model strings on OpenRouter are "<provider>/<model>".
# OpenRouter renames models periodically — if you see a 404 "model not found",
# list current IDs with:
#   curl -H "Authorization: Bearer $OPENROUTER_API_KEY" https://openrouter.ai/api/v1/models
# or browse https://openrouter.ai/models
#
# Defaults below use openai/gpt-4o family — stable, cheap, available on every
# OpenRouter account. Swap to claude (anthropic/claude-sonnet-4 etc.),
# gemini, deepseek, llama, or any other model OpenRouter routes to.
LLM_MODEL=anthropic/claude-sonnet-4.6
# Cheap+fast for the JD analysis + PDF-parsing steps:
LLM_MODEL_ANALYZE=anthropic/claude-haiku-4.5
# Resume gen is the highest-value generation — spend on quality:
LLM_MODEL_RESUME=anthropic/claude-sonnet-4.6
LLM_MODEL_PROPOSAL=anthropic/claude-sonnet-4.6

# Per-call timeout (ms). Resume gen on Sonnet can take ~60-90s; 3 min gives
# headroom + a retry. (The extension's apiClient.ts uses the same 180s.)
LLM_TIMEOUT_MS=180000
# Retries when the model returns malformed JSON or fails Zod validation.
# (The SDK auto-retries 429/5xx separately with backoff.)
LLM_MAX_VALIDATION_RETRIES=2

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
