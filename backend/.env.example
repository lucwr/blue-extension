# --- Server ---
PORT=8787
NODE_ENV=development

# Comma-separated list of allowed origins for CORS. The Chrome extension is
# served from chrome-extension://<id>/, and the loader URL changes on every
# unpacked install — keep this permissive in dev and tighten in production.
CORS_ORIGINS=*

# --- Auth ---
# Required. HS256 secret used to sign short-lived JWTs that the extension
# presents on every API call.
JWT_SECRET=replace-me-with-a-long-random-string

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Default model id. Override per-route via ANTHROPIC_MODEL_ANALYZE /
# ANTHROPIC_MODEL_RESUME / ANTHROPIC_MODEL_PROPOSAL.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Resume generation is the highest-value, lowest-volume call — use Opus.
ANTHROPIC_MODEL_RESUME=claude-opus-4-7
# Per-call timeout (ms). Generous because messages.parse + caching is fast on warm prefixes.
ANTHROPIC_TIMEOUT_MS=60000
# Retries when schema validation fails (parsed_output === null).
# Note: the SDK already auto-retries 429/5xx internally with backoff.
ANTHROPIC_MAX_VALIDATION_RETRIES=2

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
